# ==========================================
# OceanShield Backend Environment Configuration
# ==========================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/oceanshield

# JWT Authentication
JWT_SECRET=supersecret_oceanshield_jwt_key_development_only_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=supersecret_oceanshield_refresh_key_development_only
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Frontend Origin(s)
CLIENT_URL=http://localhost:5173

# Python AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Redis Cache & Queue (Optional in dev, required in production background worker)
REDIS_URL=redis://localhost:6379

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_MAX=15

# Geospatial Clustering Thresholds
INCIDENT_CLUSTER_RADIUS_METERS=5000
INCIDENT_CLUSTER_TIME_MINUTES=1440

# File Upload Configuration
UPLOAD_MAX_SIZE_MB=25

# Notification / Email Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM=alerts@oceanshield.gov
